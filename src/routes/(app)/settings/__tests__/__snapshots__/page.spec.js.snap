          aria-expanded="false"
          class="settings-group__header settings-group__toggle"
          type="button"
        >
          <span>
            Advanced
          </span>
           
          <!---->
          <svg
            class="dusk-icon dusk-icon--size--default settings-group__toggle-icon"
            role="graphics-symbol"
            viewBox="0 0 24 24"
          >
            <path
              d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
            />
          </svg>
          
          <!---->
        </button>
      </h2>
       
      <!---->
    </article>
     
    <hr />
     
    <article
      class="settings-group"
    >
      <!---->
      <h2
        class="section-head"
      >
        <span
          aria-hidden="true"
          class="section-head__bracket section-head__bracket--open"
        >
          [
        </span>
        Support
        <!---->
        <span
          aria-hidden="true"
          class="section-head__bracket section-head__bracket--close"
        >
          ]
        </span>
        
      </h2>
      
      <!---->
       
      <p>
        Read the 
        <a
          class="dusk-anchor dusk-anchor--on-surface text-link"
          href="https://docs.dusk.network"
          rel="noopener noreferrer"
          target="_blank"
        >
          Dusk Docs
          <!---->
        </a>
        <!---->
        , ask on 
        <a
          class="dusk-anchor dusk-anchor--on-surface text-link"
          href="https://discord.gg/dusk-official"
          rel="noopener noreferrer"
          target="_blank"
        >
          Discord
          <!---->
        </a>
        <!---->
        , or report issues on 
        <a
          class="dusk-anchor dusk-anchor--on-surface text-link"
          href="https://github.com/dusk-network/web-wallet/issues"
          rel="noopener noreferrer"
          target="_blank"
        >
          GitHub
          <!---->
        </a>
        <!---->
        .
      </p>
       
      <p>
        <a
          class="dusk-anchor dusk-anchor--on-surface text-link"
          href="https://dusk.network/terms-of-use/"
          rel="noopener noreferrer"
          target="_blank"
        >
          Terms of use
          <!---->
        </a>
        <!---->
         · 
        <a
          class="dusk-anchor dusk-anchor--on-surface text-link"
          href="https://dusk.network/privacy-policy/"
          rel="noopener noreferrer"
          target="_blank"
        >
          Privacy policy
          <!---->
        </a>
        <!---->
      </p>
    </article>
     
    <hr />
     
    <article
      class="settings-group"
    >
      <!---->
      <h2
        class="section-head"
      >
        <span
          aria-hidden="true"
          class="section-head__bracket section-head__bracket--open"
        >
          [
        </span>
        Reset wallet
        <!---->
        <span
          aria-hidden="true"
          class="section-head__bracket section-head__bracket--close"
        >
          ]
        </span>
        
      </h2>
      
      <!---->
       
      <div
        class="settings-group__multi-control-content"
      >
        <p>
          Resetting clears the cache, settings, contacts and connected EVM
          wallets, not your funds. You'll need your recovery phrase to restore
          access, so make sure it's stored securely.
        </p>
         
        <!---->
        <details
          class="dusk-error-details dusk-error-details__details"
        >
          <summary
            class="dusk-error-details__summary"
          >
            Couldn't reset the wallet. Try again.
          </summary>
           
          <pre
            class="dusk-error-details__error"
          >
            
			Clear data error
		
          </pre>
        </details>
        
        <!---->
         
        <button
          class="dusk-button dusk-button--type--button dusk-button--variant--primary dusk-button--size--default settings-group__button--state--danger"
          data-tooltip-disabled="true"
          data-tooltip-id="main-tooltip"
          data-tooltip-text="Not allowed to reset while syncing"
          data-tooltip-type="warning"
          type="button"
        >
          <span
            class="dusk-button__text"
          >
            Reset Wallet
          </span>
          <!---->
        </button>
        <!---->
      </div>
    </article>
  </div>
</section>
`;

