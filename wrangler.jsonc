{
  // Each network is its own build, with its settings in deployments.json.
  // deploy/site/ is what's served: the build at wallet/, where
  // deploy/stage.js places it, and the headers for it. deploy/worker.js
  // answers what no file does. The address mustn't change: browsers keep
  // each wallet by its origin.
  "name": "web-wallet",
  "main": "deploy/worker.js",
  "account_id": "73fe1e33bc30f9350533005be8c1d297",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./deploy/site",
    "binding": "ASSETS",
  },
  // At its own address alone, never at a workers.dev one too.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "testnet": {
      "name": "web-wallet-testnet",
      "routes": [
        { "pattern": "apps.testnet.dusk.network", "custom_domain": true },
      ],
      "vars": {
        // The test build's signing certificate, the debug keystore's the
        // test APKs are built with: Android opens the wallet's links in the
        // Dusk Wallet app signed with it (/.well-known/assetlinks.json).
        "ANDROID_CERTS": "2B:F9:B8:C1:BD:0D:D3:AE:19:70:5F:E0:CF:C5:54:21:CF:49:68:D3:AA:AF:3B:6D:35:2B:49:D7:65:CA:3D:A6",
        "EXPLORER": "https://explorer.testnet.dusk.network",
      },
    },
    // Not deployed yet: mainnet moves with the wallet's v2 (.github/workflows/deploy.yml).
    "mainnet": {
      "name": "web-wallet-mainnet",
      "routes": [{ "pattern": "apps.dusk.network", "custom_domain": true }],
      "vars": {
        // RELEASE KEY: the SHA-256 fingerprint of the release key the Dusk
        // Wallet app is signed with, once there is one (AA:BB:…, several
        // comma-separated). Until then, no app opens mainnet's links.
        "ANDROID_CERTS": "",
        "EXPLORER": "https://explorer.dusk.network",
      },
    },
  },
}
