{
  // Each network is its own build, with its settings in deployments.json.
  // deploy/site/ is what's served: the build at wallet/, where
  // deploy/stage.js places it, and the headers for it. deploy/worker.js
  // answers what no file does. The address mustn't change: browsers keep
  // each wallet by its origin.
  "name": "web-wallet",
  "main": "deploy/worker.js",
  "account_id": "73fe1e33bc30f9350533005be8c1d297",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./deploy/site",
    "binding": "ASSETS",
  },
  // At its own address alone, never at a workers.dev one too.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "testnet": {
      "name": "web-wallet-testnet",
      "routes": [
        { "pattern": "apps.testnet.dusk.network", "custom_domain": true },
      ],
      "vars": { "EXPLORER": "https://explorer.testnet.dusk.network" },
    },
    // Not deployed yet: mainnet moves with the wallet's v2 (.github/workflows/deploy.yml).
    "mainnet": {
      "name": "web-wallet-mainnet",
      "routes": [{ "pattern": "apps.dusk.network", "custom_domain": true }],
      "vars": { "EXPLORER": "https://explorer.dusk.network" },
    },
  },
}
